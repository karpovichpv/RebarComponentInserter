<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<UseWpf>true</UseWpf>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Tekla.Structures" Version="2024.0.4" />
		<PackageReference Include="Tekla.Structures.Catalogs" Version="2024.0.4" />
		<PackageReference Include="Tekla.Structures.Model" Version="2024.0.4" />
		<PackageReference Include="Tekla.Structures.Plugins" Version="2024.0.4" />
		<PackageReference Include="Tekla.Structures.Dialog" Version="2024.0.4" />
		<PackageReference Include="NLog" Version="5.4.0" />
		<PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
	</ItemGroup>
	<Target Name="WriteBuildDate" BeforeTargets="PreBuildEvent">
		<Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(SolutionDir)WriteBuildDate.ps1&quot;" />
	</Target>
	<ItemGroup>
		<EmbeddedResource Include="Resources\BuildDate.md" />
		<Content Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<Target Name="CopyToTeklaExtensions" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="C:\TeklaStructures\2024.0\Environments\common\extensions" />
		<ItemGroup>
			<PdbFiles Include="$(TargetDir)$(AssemblyName).pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(PdbFiles)" DestinationFolder="C:\TeklaStructures\2024.0\Environments\common\extensions" SkipUnchangedFiles="true" />
	</Target>
</Project>